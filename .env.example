# Copy to .env for local development. Never commit the real file.

# REQUIRED in production (NODE_ENV=production) and must be at least 32 chars.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Development falls back to a built-in, non-secret value when this is empty.
SESSION_SECRET=

# Runtime
# NODE_ENV=development
# PORT=4000

# Database (defaults to server/data/uniexpert.db). Tests must set their own path.
# DB_PATH=
# SEED_DEMO_DATA=1
# SESSION_TTL_DAYS=7

# Set to 1 only when the app runs behind a trusted reverse proxy.
# TRUST_PROXY=0

# Abuse protection. Defaults shown; set RATE_LIMIT_DISABLED=1 only in automated tests.
# LOGIN_RATE_LIMIT_MAX=20
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# REGISTER_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# WRITE_RATE_LIMIT_MAX=60
# WRITE_RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_DISABLED=0
